// Prisma schema for User CMS core entities

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  role              Role
  status            UserStatus
  preferredLanguage String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?

  apiKeys                 ApiKey[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                UserSession[]
}

model ApiKey {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  name       String?
  secretHash String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  isEnabled  Boolean   @default(true)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model UserSession {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
}

enum Role {
  admin
  contributor
  user
}

enum UserStatus {
  email_not_verified
  active
  inactive
  anonymized
}
